resource "aws_iam_role_policy" "eks_custom_policy" {
  name = "eks-custom-inline-policy"
  role = module.eks.cluster_iam_role_name

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "ec2:DescribeInstances"
        ]
        Resource = "*"
      }
    ]
  })
}

# If you want Terraform to own all inline policies on the role, try the definition below
