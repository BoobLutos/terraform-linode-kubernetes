resource "kubernetes_config_map_v1" "aws_auth" {
  metadata {
    name      = "aws-auth"
    namespace = "kube-system"
  }

  data = {
    mapUsers = yamlencode([
      {
        userarn  = "arn:aws:iam::046145782566:user/devops"
        username = "admin"
        groups   = ["system:masters"]
      }
    ])
  }

  depends_on = [module.eks]
}
