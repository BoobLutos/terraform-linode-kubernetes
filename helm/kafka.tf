resource "kubernetes_namespace_v1" "kafka" {
  metadata {
    name = "kafka"
  }
}

# Credentials for the Kafka client (SASL/PLAIN) listener and for Kafka UI's
# login form. Alphanumeric-only so the SASL password is safe to embed
# unescaped inside a JAAS config string.
resource "random_password" "kafka_sasl" {
  length  = 24
  special = false
}

resource "random_password" "kafka_ui_admin" {
  length  = 24
  special = false
}

locals {
  kafka_sasl_username = "app-user"
  kafka_ui_admin_user = "admin"
}

# -------------------------
# KAFKA (KRaft, single broker)
# -------------------------
# Internal only: reachable inside the cluster at kafka.kafka.svc.cluster.local:9092
# using SASL/PLAIN over the plain Kafka wire protocol, for producers/consumers
# running as other in-cluster workloads (e.g. n8n, or apps deployed via ArgoCD).
resource "helm_release" "kafka" {
  name       = "kafka"
  namespace  = kubernetes_namespace_v1.kafka.metadata[0].name
  repository = "https://charts.bitnami.com/bitnami"
  chart      = "kafka"
  version    = "32.4.3"

  timeout = 600

  # Bitnami emptied the free docker.io/bitnami/* images in their Aug 2025
  # restructuring; old free tags now live under bitnamilegacy/*.
  # Replication factors are pinned to 1 because this is a single-broker
  # cluster — the chart's defaults (3) leave internal topics like
  # __consumer_offsets stuck unable to satisfy their replication factor,
  # which silently breaks all consumers.
  # Inter-broker/controller SASL credentials are left unset so the chart
  # auto-generates and stores them itself — only the client-facing
  # credentials need to be known outside the cluster.
  values = [
    yamlencode({
      image = {
        repository = "bitnamilegacy/kafka"
      }
      controller = {
        replicaCount    = 1
        resourcesPreset = "small"
        # overrideConfiguration merges on top of the chart's auto-generated
        # server.properties; controller.config would replace it wholesale
        # and drop required settings like process.roles.
        overrideConfiguration = {
          "offsets.topic.replication.factor"         = 1
          "transaction.state.log.replication.factor" = 1
          "transaction.state.log.min.isr"            = 1
          "default.replication.factor"               = 1
        }
      }
      listeners = {
        client      = { protocol = "SASL_PLAINTEXT" }
        interbroker = { protocol = "SASL_PLAINTEXT" }
        controller  = { protocol = "SASL_PLAINTEXT" }
      }
      sasl = {
        enabledMechanisms    = "PLAIN"
        interBrokerMechanism = "PLAIN"
        controllerMechanism  = "PLAIN"
        client = {
          users     = [local.kafka_sasl_username]
          passwords = [random_password.kafka_sasl.result]
        }
      }
      tls = {
        autoGenerated = {
          enabled = false
        }
      }
    })
  ]

  depends_on = [kubernetes_namespace_v1.kafka]
}

# -------------------------
# KAFKA UI (management GUI)
# -------------------------
resource "helm_release" "kafka_ui" {
  name       = "kafka-ui"
  namespace  = kubernetes_namespace_v1.kafka.metadata[0].name
  repository = "https://provectus.github.io/kafka-ui-charts"
  chart      = "kafka-ui"
  version    = "0.7.6"

  values = [
    yamlencode({
      yamlApplicationConfig = {
        kafka = {
          clusters = [
            {
              name             = "kafka"
              bootstrapServers = "kafka.kafka.svc.cluster.local:9092"
              properties = {
                "security.protocol" = "SASL_PLAINTEXT"
                "sasl.mechanism"    = "PLAIN"
                "sasl.jaas.config"  = "org.apache.kafka.common.security.plain.PlainLoginModule required username=\"${local.kafka_sasl_username}\" password=\"${random_password.kafka_sasl.result}\";"
              }
            }
          ]
        }
        # Login form so Kafka UI itself requires authentication.
        auth = {
          type = "LOGIN_FORM"
        }
        spring = {
          security = {
            user = {
              name     = local.kafka_ui_admin_user
              password = random_password.kafka_ui_admin.result
            }
          }
        }
        management = {
          health = {
            ldap = {
              enabled = false
            }
          }
        }
      }
    })
  ]

  depends_on = [kubernetes_namespace_v1.kafka, helm_release.kafka, helm_release.nginx_ingress]
}

resource "kubernetes_ingress_v1" "kafka_ui" {
  metadata {
    name      = "kafka-ui"
    namespace = kubernetes_namespace_v1.kafka.metadata[0].name
    annotations = {
      "nginx.ingress.kubernetes.io/backend-protocol" = "HTTP"
      "cert-manager.io/cluster-issuer"               = "letsencrypt-prod"
    }
  }

  spec {
    ingress_class_name = "nginx"

    tls {
      hosts       = ["kafka.sinza.org"]
      secret_name = "kafka-ui-tls"
    }

    rule {
      host = "kafka.sinza.org"

      http {
        path {
          path      = "/"
          path_type = "Prefix"

          backend {
            service {
              name = "kafka-ui"
              port {
                number = 80
              }
            }
          }
        }
      }
    }
  }

  depends_on = [helm_release.kafka_ui, kubectl_manifest.letsencrypt_prod]
}
